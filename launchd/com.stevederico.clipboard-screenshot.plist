<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!-- Template only. install.sh generates the live plist with absolute paths. -->
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>com.stevederico.clipboard-screenshot</string>

    <key>ProgramArguments</key>
    <array>
        <string>PATH_TO_SCREENSHOTS_DIR/Clipboard Screenshot.app/Contents/MacOS/clipboard-screenshot</string>
    </array>

    <key>WatchPaths</key>
    <array>
        <string>PATH_TO_DESKTOP</string>
    </array>

    <key>ThrottleInterval</key>
    <integer>1</integer>

    <key>ExitTimeOut</key>
    <integer>30</integer>

    <key>RunAtLoad</key>
    <true/>
    <key>KeepAlive</key>
    <false/>

    <key>LimitLoadToSessionType</key>
    <string>Aqua</string>

    <key>ProcessType</key>
    <string>Interactive</string>

    <key>EnvironmentVariables</key>
    <dict>
        <key>PATH</key>
        <string>/usr/local/bin:/usr/bin:/bin:/usr/sbin:/sbin:/opt/homebrew/bin</string>
        <key>SCREENSHOTS_DIR</key>
        <string>PATH_TO_SCREENSHOTS_DIR</string>
        <key>HOME</key>
        <string>PATH_TO_HOME</string>
    </dict>

    <key>StandardOutPath</key>
    <string>PATH_TO_SCREENSHOTS_DIR/watcher.log</string>
    <key>StandardErrorPath</key>
    <string>PATH_TO_SCREENSHOTS_DIR/watcher.log</string>
</dict>
</plist>
